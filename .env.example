# Kopiera till .env.local och fyll i. Värdena hittas i din Supabase-panel
# under Project Settings → API. Se docs/INSTALLATION.md steg 7.

# Krävs
NEXT_PUBLIC_SUPABASE_URL=https://<ditt-projekt-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-nyckeln>

# Fakturor via e-post (valfritt): kräver verifierad avsändardomän hos resend.com
# RESEND_API_KEY=re_...
# INVOICE_FROM_EMAIL=faktura@dittforetag.se

# Läs-API för egna integrationer (valfritt, se docs/INSTALLATION.md):
# båda krävs tillsammans. Service-nyckeln går förbi alla säkerhetsregler —
# får ALDRIG hamna i webbläsaren eller committas.
# STATS_API_KEY=<lång-slumpad-sträng>
# SUPABASE_SERVICE_ROLE_KEY=<service-nyckeln>

# Byråns åtkomst (valfritt): kräver SUPABASE_SERVICE_ROLE_KEY ovan, men INTE
# STATS_API_KEY. Nyckeln till byrån skapas sedan i appen under
# Inställningar → Byråns åtkomst — inte här.
